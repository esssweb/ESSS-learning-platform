# Database - Local PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your-password-here
DB_DATABASE=esss_learning
DB_DIALECT=postgres

# Database - GCP PostgreSQL (Production)
# Uncomment and configure for production
# DB_HOST=your-gcp-instance-ip
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=your-gcp-password
# DB_DATABASE=esss_learning

# JWT Authentication
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your-refresh-token-secret-change-in-production
REFRESH_TOKEN_EXPIRES_IN=7d

# Firebase (Push Notifications)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Supabase (File Storage)
SUPABASE_URL=
SUPABASE_KEY=

# Application
PORT=3000
NODE_ENV=development

# Optional: Redis (if implementing caching)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Email Service — Google Apps Script (primary, recommended)
# Deploy the Apps Script as a Web App and paste its details here.
GOOGLE_SCRIPT_ID=
GOOGLE_SCRIPT_URL=

# Frontend base URL used to build magic-links inside verification emails
FRONTEND_URL=http://localhost:3001

# Email Service — SMTP fallback (used when GOOGLE_SCRIPT_URL is not set)
# When neither is configured, OTP codes are logged to console (dev only)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
